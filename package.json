{
  "name": "dsh-quarto-book",
  "version": "0.1.0",
  "description": "Quarto book authoring for DeepSeek Harness: a read-only book audit tool and a bundled heading-reorder skill.",
  "type": "module",
  "main": "./src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "assets",
    "cordis.patch.yml",
    "dsh.plugin.json",
    "README.md",
    "README.en.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22",
    "dsh": ">=0.1.7-rc"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "test": "node test/audit.test.js && node test/yaml-lite.test.js && node test/plugin.test.js && node test/manifest.test.js",
    "test:runner": "node --test test"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "quarto",
    "quarto-book",
    "markdown",
    "publishing",
    "skill"
  ],
  "license": "MIT",
  "author": "chengzhao-dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chengzhao-dev/dsh-quarto-book.git"
  },
  "bugs": {
    "url": "https://github.com/chengzhao-dev/dsh-quarto-book/issues"
  },
  "homepage": "https://github.com/chengzhao-dev/dsh-quarto-book#readme",
  "publishConfig": {
    "access": "public"
  }
}
