{
  "name": "@chengzhao-dev/dsh-quarto-book",
  "version": "0.6.3",
  "description": "润色中文技术章节，检查 Book 结构与中英混排，并维护一套统一、可读的阅读主题。 · Polish Chinese technical chapters, check book structure and mixed Chinese-English prose, and maintain a consistent, readable theme.",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "lib",
    "skills",
    "cordis.patch.yml",
    "locale",
    "icon.svg",
    "README.md",
    "README.en.md",
    "LICENSE",
    "templates",
    "!**/__pycache__",
    "!**/__pycache__/**",
    "!**/*.pyc"
  ],
  "engines": {
    "node": ">=22",
    "dsh": ">=0.2.0-rc.1 <0.3.0-0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "catalog": {
      "category": "skill",
      "summary": {
        "zh": "润色中文技术章节，检查 Book 结构与中英混排，并维护一套统一、可读的阅读主题。",
        "en": "Polish Chinese technical chapters, check book structure and mixed Chinese-English prose, and maintain a consistent, readable theme."
      },
      "capabilities": [
        "skills",
        "tools"
      ]
    }
  },
  "icon": "./icon.svg",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test tests/*.test.mjs",
    "check": "tsc --noEmit -p tsconfig.json && node scripts/checking-skill-links.mjs",
    "pack": "node -e \"require('fs').mkdirSync('temp',{recursive:true})\" && npm pack --pack-destination temp",
    "pack:check": "npm pack --dry-run"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "quarto",
    "quarto-book",
    "technical-writing",
    "theme",
    "skill"
  ],
  "license": "MIT",
  "author": "chengzhao-dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chengzhao-dev/dsh-quarto-book.git"
  },
  "bugs": {
    "url": "https://github.com/chengzhao-dev/dsh-quarto-book/issues"
  },
  "homepage": "https://github.com/chengzhao-dev/dsh-quarto-book#readme",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-skill": ">=0.2.0-rc.1 <0.3.0-0"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-skill": ">=0.2.0-rc.1 <0.3.0-0",
    "@types/node": "^22.20.5",
    "typescript": "^5.9.3"
  }
}
