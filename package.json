{
  "name": "@chengzhao-dev/dsh-quarto-book",
  "version": "0.4.0",
  "description": "为 Quarto Book 写章节、校验结构并维护可复用主题；不改业务代码，只在 type: book 的仓库里出现。 · Author and check Quarto Book chapters and maintain a reusable theme; no business code, only inside `type: book` repositories.",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "lib",
    "skills",
    "cordis.patch.yml",
    "locale",
    "icon.svg",
    "README.md",
    "README.en.md",
    "LICENSE",
    "templates",
    "docs",
    "scripts"
  ],
  "engines": {
    "node": ">=22",
    "dsh": ">=0.2.0-rc.1 <0.3.0-0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "catalog": {
      "category": "workflow",
      "summary": {
        "zh": "为 Quarto Book 写章节、校验结构并维护可复用主题；不改业务代码，只在 type: book 的仓库里出现。",
        "en": "Author and check Quarto Book chapters and maintain a reusable theme; no business code, only inside `type: book` repositories."
      },
      "capabilities": ["skills", "tools"]
    }
  },
  "icon": "./icon.svg",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test tests/*.test.mjs",
    "check": "tsc --noEmit -p tsconfig.json && node scripts/checking-skill-links.mjs",
    "pack:check": "npm pack --dry-run"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "quarto",
    "quarto-book",
    "technical-writing",
    "theme",
    "skill"
  ],
  "license": "MIT",
  "author": "chengzhao-dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chengzhao-dev/dsh-quarto-book.git"
  },
  "bugs": {
    "url": "https://github.com/chengzhao-dev/dsh-quarto-book/issues"
  },
  "homepage": "https://github.com/chengzhao-dev/dsh-quarto-book#readme",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-skill": ">=0.2.0-rc.1 <0.3.0-0"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-skill": ">=0.2.0-rc.1 <0.3.0-0",
    "@types/node": "^22.20.5",
    "typescript": "^5.9.3"
  }
}
